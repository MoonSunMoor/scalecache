From 551f6716ca26f07a61b076ef22c52c13d8aa8c08 Mon Sep 17 00:00:00 2001
From: moonsunmoor <moonsunmoor@gmail.com>
Date: Sat, 28 Nov 2026 05:14:05 +0000
Subject: [PATCH 1/5] pxt4, jbd3: build out of tree

Replace the kbuild Makefiles with out-of-tree ones that build pxt4.ko and
jbd3.ko in one pass against a ScaleCache kernel (KDIR).  pxt4 has no
Kconfig of its own: it builds acl.o, xattr_security.o, verity.o and
crypto.o and defines CONFIG_PXT4_FS_POSIX_ACL, CONFIG_PXT4_FS_SECURITY
and CONFIG_PXT4_DEBUG from the kernel's ext4 options, and jbd3 defines
CONFIG_JBD3_DEBUG from CONFIG_JBD2_DEBUG.  The Kconfig files are dropped.

The 6.6.8 pxt4 built acl.o and xattr_security.o unconditionally but left
the CONFIG_PXT4_* checks in super.c, xattr.c and ialloc.c undefined, so
its ACL xattr handlers and the acl mount option were compiled out.  The
KUnit tests stay out of the build (CONFIG_PXT4_KUNIT_TESTS is not set).
---
 Kconfig       | 92 ---------------------------------------------------
 Makefile      | 31 +++++++++++++----
 jbd3/Kconfig  | 34 -------------------
 jbd3/Makefile | 22 ++++++++++--
 4 files changed, 44 insertions(+), 135 deletions(-)
 delete mode 100644 Kconfig
 delete mode 100644 jbd3/Kconfig

diff --git a/Kconfig b/Kconfig
deleted file mode 100644
index cd61c2a..0000000
--- a/Kconfig
+++ /dev/null
@@ -1,92 +0,0 @@
-# SPDX-License-Identifier: GPL-2.0-only
-config PXT4_FS
-	tristate "The Extended 4 (pxt4) filesystem"
-	select BUFFER_HEAD
-	select JBD3
-	select CRC16
-	select CRC32
-	select FS_IOMAP
-	select FS_ENCRYPTION_ALGS if FS_ENCRYPTION
-	help
-	  This is the next generation of the ext3 filesystem.
-
-	  Unlike the change from ext2 filesystem to ext3 filesystem,
-	  the on-disk format of pxt4 is not forwards compatible with
-	  ext3; it is based on extent maps and it supports 48-bit
-	  physical block numbers.  The pxt4 filesystem also supports delayed
-	  allocation, persistent preallocation, high resolution time stamps,
-	  and a number of other features to improve performance and speed
-	  up fsck time.  For more information, please see the web pages at
-	  http://pxt4.wiki.kernel.org.
-
-	  The pxt4 filesystem supports mounting an ext3 filesystem; while there
-	  are some performance gains from the delayed allocation and inode
-	  table readahead, the best performance gains require enabling pxt4
-	  features in the filesystem using tune2fs, or formatting a new
-	  filesystem as an pxt4 filesystem initially. Without explicit enabling
-	  of pxt4 features, the on disk filesystem format stays fully backward
-	  compatible.
-
-	  To compile this file system support as a module, choose M here. The
-	  module will be called pxt4.
-
-	  If unsure, say N.
-
-config PXT4_USE_FOR_EXT2
-	bool "Use pxt4 for ext2 file systems"
-	depends on PXT4_FS
-	depends on EXT2_FS=n
-	default y
-	help
-	  Allow the pxt4 file system driver code to be used for ext2
-	  file system mounts.  This allows users to reduce their
-	  compiled kernel size by using one file system driver for
-	  ext2, ext3, and pxt4 file systems.
-
-config PXT4_FS_POSIX_ACL
-	bool "Pxt4 POSIX Access Control Lists"
-	depends on PXT4_FS
-	select FS_POSIX_ACL
-	help
-	  POSIX Access Control Lists (ACLs) support permissions for users and
-	  groups beyond the owner/group/world scheme.
-
-	  If you don't know what Access Control Lists are, say N
-
-config PXT4_FS_SECURITY
-	bool "Pxt4 Security Labels"
-	depends on PXT4_FS
-	help
-	  Security labels support alternative access control models
-	  implemented by security modules like SELinux.  This option
-	  enables an extended attribute handler for file security
-	  labels in the pxt4 filesystem.
-
-	  If you are not using a security module that requires using
-	  extended attributes for file security labels, say N.
-
-config PXT4_DEBUG
-	bool "Pxt4 debugging support"
-	depends on PXT4_FS
-	help
-	  Enables run-time debugging support for the pxt4 filesystem.
-
-	  If you select Y here, then you will be able to turn on debugging
-	  using dynamic debug control for mb_debug() / ext_debug() msgs.
-
-config PXT4_KUNIT_TESTS
-	tristate "KUnit tests for pxt4" if !KUNIT_ALL_TESTS
-	depends on PXT4_FS && KUNIT
-	default KUNIT_ALL_TESTS
-	help
-	  This builds the pxt4 KUnit tests.
-
-	  KUnit tests run during boot and output the results to the debug log
-	  in TAP format (https://testanything.org/). Only useful for kernel devs
-	  running KUnit test harness and are not for inclusion into a production
-	  build.
-
-	  For more information on KUnit and unit tests in general please refer
-	  to the KUnit documentation in Documentation/dev-tools/kunit/.
-
-	  If unsure, say N.
diff --git a/Makefile b/Makefile
index 856a648..d6cec35 100644
--- a/Makefile
+++ b/Makefile
@@ -1,9 +1,13 @@
 # SPDX-License-Identifier: GPL-2.0
 #
-# Makefile for the linux pxt4-filesystem routines.
+# Makefile for the pxt4 filesystem (ext4 on the ScaleCache page cache) and
+# its journal jbd3, built out of tree against a ScaleCache kernel:
+#   make KDIR=<kernel build directory>
 #
 
-obj-$(CONFIG_PXT4_FS) += pxt4.o
+ifneq ($(KERNELRELEASE),)
+
+obj-m += pxt4.o jbd3/
 
 pxt4-y	:= balloc.o bitmap.o block_validity.o dir.o pxt4_jbd3.o extents.o \
 		extents_status.o file.o fsmap.o fsync.o hash.o ialloc.o \
@@ -12,10 +16,23 @@ pxt4-y	:= balloc.o bitmap.o block_validity.o dir.o pxt4_jbd3.o extents.o \
 		super.o symlink.o sysfs.o xattr.o xattr_hurd.o xattr_trusted.o \
 		xattr_user.o fast_commit.o orphan.o
 
-pxt4-$(CONFIG_PXT4_FS_POSIX_ACL)	+= acl.o
-pxt4-$(CONFIG_PXT4_FS_SECURITY)		+= xattr_security.o
-pxt4-test-objs				+= inode-test.o mballoc-test.o \
-					   extents-test.o hash-test.o
-obj-$(CONFIG_PXT4_KUNIT_TESTS)		+= pxt4-test.o
+# pxt4 has no Kconfig of its own and follows the kernel's ext4 options.
+pxt4-$(CONFIG_EXT4_FS_POSIX_ACL)	+= acl.o
+pxt4-$(CONFIG_EXT4_FS_SECURITY)		+= xattr_security.o
 pxt4-$(CONFIG_FS_VERITY)		+= verity.o
 pxt4-$(CONFIG_FS_ENCRYPTION)		+= crypto.o
+ccflags-$(CONFIG_EXT4_FS_POSIX_ACL)	+= -DCONFIG_PXT4_FS_POSIX_ACL
+ccflags-$(CONFIG_EXT4_FS_SECURITY)	+= -DCONFIG_PXT4_FS_SECURITY
+ccflags-$(CONFIG_EXT4_DEBUG)		+= -DCONFIG_PXT4_DEBUG
+
+else
+
+KDIR	?= /lib/modules/$(shell uname -r)/build
+
+default:
+	$(MAKE) -C $(KDIR) M=$(CURDIR) modules
+
+clean:
+	$(MAKE) -C $(KDIR) M=$(CURDIR) clean
+
+endif
diff --git a/jbd3/Kconfig b/jbd3/Kconfig
deleted file mode 100644
index f386bec..0000000
--- a/jbd3/Kconfig
+++ /dev/null
@@ -1,34 +0,0 @@
-# SPDX-License-Identifier: GPL-2.0-only
-config JBD3
-	tristate
-	select CRC32
-	help
-	  This is a generic journaling layer for block devices that support
-	  both 32-bit and 64-bit block numbers.  It is currently used by
-	  the pxt4 and OCFS2 filesystems, but it could also be used to add
-	  journal support to other file systems or block devices such
-	  as RAID or LVM.
-
-	  If you are using pxt4 or OCFS2, you need to say Y here.
-	  If you are not using pxt4 or OCFS2 then you will
-	  probably want to say N.
-
-	  To compile this device as a module, choose M here. The module will be
-	  called jbd3.  If you are compiling pxt4 or OCFS2 into the kernel,
-	  you cannot compile this code as a module.
-
-config JBD3_DEBUG
-	bool "JBD3 (pxt4) debugging support"
-	depends on JBD3
-	help
-	  If you are using the pxt4 journaled file system (or
-	  potentially any other filesystem/device using JBD3), this option
-	  allows you to enable debugging output while the system is running,
-	  in order to help track down any problems you are having.
-	  By default, the debugging output will be turned off.
-
-	  If you select Y here, then you will be able to turn on debugging
-	  with "echo N > /sys/module/jbd3/parameters/jbd3_debug", where N is a
-	  number between 1 and 5. The higher the number, the more debugging
-	  output is generated.  To turn debugging off again, do
-	  "echo 0 > /sys/module/jbd3/parameters/jbd3_debug".
diff --git a/jbd3/Makefile b/jbd3/Makefile
index 9aed39b..29de9e5 100644
--- a/jbd3/Makefile
+++ b/jbd3/Makefile
@@ -1,8 +1,26 @@
 # SPDX-License-Identifier: GPL-2.0-only
 #
-# Makefile for the linux journaling routines.
+# Makefile for the jbd3 journaling routines (jbd2 for pxt4).  Built from
+# ../Makefile together with pxt4.ko, or alone:
+#   make KDIR=<kernel build directory>
 #
 
-obj-$(CONFIG_JBD3) += jbd3.o
+ifneq ($(KERNELRELEASE),)
+
+obj-m += jbd3.o
 
 jbd3-objs := transaction.o commit.o recovery.o checkpoint.o revoke.o journal.o
+
+ccflags-$(CONFIG_JBD2_DEBUG)	+= -DCONFIG_JBD3_DEBUG
+
+else
+
+KDIR	?= /lib/modules/$(shell uname -r)/build
+
+default:
+	$(MAKE) -C $(KDIR) M=$(CURDIR) modules
+
+clean:
+	$(MAKE) -C $(KDIR) M=$(CURDIR) clean
+
+endif
